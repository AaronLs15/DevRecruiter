NODE_ENV=development
PORT=3001

# SQL Server
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong!Passw0rd
MSSQL_DATABASE=DevRecruiter

DB_HOST=127.0.0.1   # ← usa 127.0.0.1, no 'localhost' (evita socket/IPv6)
DB_PORT=1433       # ← verifica el puerto (XAMPP a veces usa 3306/3307)
DB_USER=sa        # ← tu usuario real
DB_PASS=YourStrong!Passw0rd # ← tu contraseña real (puede ser vacía en XAMPP: deja DB_PASS vacío)
DB_NAME=DevRecruiter     # ← la base existe y coincide el nombre

# JWT
ACCESS_TOKEN_SECRET=super_secret_accesstoken_32chars_min
REFRESH_TOKEN_SECRET=super_secret_refreshtoken_32chars_min
ACCESS_TOKEN_TTL=15m       # token de acceso (corto)
REFRESH_TOKEN_TTL_DAYS=30  # cookie persistente (configurable)

# Tiempo de inactividad (auto-logout)
IDLE_TIMEOUT_MIN=30

# CORS
FRONTEND_URL=http://localhost:5173
